# คัดลอกไฟล์นี้เป็น .env.local แล้วแทนค่าตัวอย่างด้วยค่าของโปรเจกต์คุณ
# หากมี .env.local อยู่แล้ว ให้แก้เฉพาะค่าที่ต้องการ ไม่ต้องคัดลอกทับ
# ดูทั้งสองค่าได้จาก Supabase Dashboard > โปรเจกต์ของคุณ > Connect
# หลังแก้ไข ให้หยุดแล้วรัน npm run dev ใหม่

# Project URL ของ Supabase (ไม่ใช่ URL ของ Dashboard หรือ connection string ฐานข้อมูล)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Publishable key จากโปรเจกต์เดียวกัน (ขึ้นต้นด้วย sb_publishable_)
# ค่านี้ถูกส่งไปยัง browser: ห้ามใช้ secret key หรือ service_role key
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here
